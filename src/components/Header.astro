---
/**
 * Peldošā galvene: atdalīta, noapaļota „pill” josla lapas iekšpusē (A4 §2).
 * Logo vienmēr redzams; ritinot josla nedaudz sarūk un kļūst necaurspīdīgāka.
 * Mobilajā: logo, apaļa zvana poga un izvēlnes poga → pilnekrāna izvēlne.
 */
import { contact, hours, links } from '../config';
import { logos } from '../data/images';
import { mainNav } from '../data/navigation';
import { buildLogo } from '../lib/picture';
import Icon from './Icon.astro';

const logo = await buildLogo(logos.header.src, 44);
// Būvējot ar build.format 'file', ceļš ir „/cenas.html” - noņemam „.html”, „/index” un beigu slīpsvītru.
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href);
const servicesOpenOnPage = mainNav.find((n) => n.children)?.children?.some((c) => isCurrent(c.href));
---

<header class="site-header" data-header>
  <div class="bar">
    <a class="brand" href="/">
      <img src={logo.src} srcset={logo.srcset} width={logo.width} height={logo.height} alt={logos.header.alt} />
    </a>

    <nav class="nav" aria-label="Galvenā izvēlne">
      <ul role="list" class="nav__list">
        {
          mainNav.map((item) =>
            item.children ? (
              <li class="nav__item nav__item--has-menu" data-dropdown>
                <button
                  class:list={['nav__link', 'nav__toggle', { 'is-current': servicesOpenOnPage }]}
                  type="button"
                  aria-expanded="false"
                  aria-controls="pakalpojumu-izvelne"
                >
                  {item.label}
                  <Icon name="chevron" size={16} class="nav__chevron" />
                </button>
                <div class="dropdown" id="pakalpojumu-izvelne">
                  <ul role="list">
                    {item.children.map((child) => (
                      <li>
                        <a
                          class="dropdown__link"
                          href={child.href}
                          aria-current={isCurrent(child.href) ? 'page' : undefined}
                        >
                          {child.label}
                          <Icon name="arrow" size={18} class="dropdown__arrow" />
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li class="nav__item">
                <a
                  class:list={['nav__link', { 'is-current': isCurrent(item.href) }]}
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <a class="phone" href={links.tel}><Icon name="phone" size={16} />{contact.phoneDisplay}</a>

    <a class="call" href={links.tel}>
      <Icon name="phone" size={19} />
      <span>Zvanīt Zaigai</span>
    </a>

    <div class="mobile-actions">
      <a class="round round--call" href={links.tel} aria-label={`Zvanīt Zaigai: ${contact.phoneDisplay}`}>
        <Icon name="phone" size={20} />
      </a>
      <a class="round round--menu" href="#kajenes-izvelne" data-menu-open aria-haspopup="dialog" aria-controls="izvelne">
        <Icon name="menu" size={22} />
        <span class="visually-hidden">Atvērt izvēlni</span>
      </a>
    </div>
  </div>
</header>

<dialog class="sheet" id="izvelne" aria-label="Izvēlne" data-menu>
  <div class="sheet__inner">
    <div class="sheet__top">
      <a class="brand" href="/" aria-label={logos.header.alt}>
        <img src={logo.src} srcset={logo.srcset} width={logo.width} height={logo.height} alt="" loading="lazy" />
      </a>
      <button class="round round--close" type="button" data-menu-close>
        <Icon name="close" size={22} />
        <span class="visually-hidden">Aizvērt izvēlni</span>
      </button>
    </div>

    <nav class="sheet__nav" aria-label="Lapas">
      <ul role="list">
        {
          mainNav.map((item) =>
            item.children ? (
              <li class="sheet__group">
                <span class="label sheet__label">{item.label}</span>
                <ul role="list" class="sheet__sub">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} aria-current={isCurrent(child.href) ? 'page' : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a class="sheet__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="sheet__contact">
      <a class="sheet__btn sheet__btn--call" href={links.tel}>
        <Icon name="phone" size={22} />
        <span>Zvanīt <span class="sheet__num">{contact.phoneDisplay}</span></span>
      </a>
      <a class="sheet__btn sheet__btn--wa" href={links.whatsapp} target="_blank" rel="noopener noreferrer">
        <Icon name="whatsapp" size={22} />
        <span>WhatsApp</span>
      </a>
      <p class="sheet__meta">
        {contact.address.street}, {contact.address.city} · <span class="nowrap"
          ><span aria-hidden="true">{hours.daysShort}</span><span class="visually-hidden">{hours.daysLong}</span>
          {hours.time}</span
        >
      </p>
    </div>
  </div>
</dialog>

<style>
  .site-header {
    position: fixed;
    z-index: 100;
    top: var(--header-top);
    left: max(var(--header-side), var(--safe-l));
    right: max(var(--header-side), var(--safe-r));
    max-width: var(--container);
    margin-inline: auto;
    pointer-events: none;
  }

  /* Maigs plīvurs virs peldošās joslas, kad lapa ritināta */
  .site-header::before {
    content: '';
    position: fixed;
    z-index: -1;
    left: 0;
    right: 0;
    top: 0;
    height: calc(var(--header-top) + var(--header-h) * 0.6);
    background: linear-gradient(180deg, rgb(250 245 238 / 0.94) 0%, rgb(250 245 238 / 0.7) 55%, rgb(250 245 238 / 0) 100%);
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
    pointer-events: none;
  }

  .site-header.is-scrolled::before {
    opacity: 1;
  }

  /* Virs tumšās kājenes plīvurs kļūst šokolādes krāsā */
  .site-header.is-over-dark::before {
    background: linear-gradient(180deg, rgb(82 27 16 / 0.92) 0%, rgb(82 27 16 / 0.6) 55%, rgb(82 27 16 / 0) 100%);
  }

  .bar {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 12px;
    height: var(--header-h);
    padding: 0 2px 0 16px;
    border-radius: var(--r-pill);
    background: rgb(250 245 238 / 0.72);
    -webkit-backdrop-filter: blur(14px) saturate(1.25);
    backdrop-filter: blur(14px) saturate(1.25);
    box-shadow:
      inset 0 0 0 1px rgb(82 27 16 / 0.09),
      0 1px 2px rgb(82 27 16 / 0.04),
      0 14px 34px -22px rgb(82 27 16 / 0.42);
    transition:
      height var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  .site-header.is-scrolled .bar {
    background: rgb(250 245 238 / 0.88);
    box-shadow:
      inset 0 0 0 1px rgb(82 27 16 / 0.1),
      0 1px 2px rgb(82 27 16 / 0.05),
      0 16px 36px -20px rgb(82 27 16 / 0.45);
  }

  .brand {
    display: flex;
    align-items: center;
    flex: none;
    min-height: 48px;
    margin-right: auto;
    border-radius: 10px;
  }

  .brand img {
    height: 34px;
    width: auto;
    transition: height var(--dur) var(--ease-out);
  }

  /* Ritinot josla nedaudz sarūk (pogu pieskāriena laukums paliek 48 px) */
  .site-header.is-scrolled .bar {
    height: 48px;
  }

  .site-header.is-scrolled .brand img {
    height: 31px;
  }

  .nav,
  .call,
  .phone {
    display: none;
  }

  .mobile-actions {
    display: flex;
    align-items: center;
    gap: 0;
  }

  /* 48 px pieskāriena laukums; redzamais aplis 42 px (fons tikai satura laukumā) */
  .round {
    position: relative;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 3px;
    border-radius: 50%;
    border: 0;
    background: none;
    background-clip: content-box;
    color: var(--chocolate);
    -webkit-tap-highlight-color: transparent;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .round--call {
    background-color: var(--rose-cta);
    color: #fff;
  }

  .round--call:hover {
    background-color: var(--rose-cta-hover);
    color: #fff;
  }

  .round--menu:hover,
  .round--close:hover {
    background-color: rgb(82 27 16 / 0.07);
  }

  /* Darbvirsma */
  @media (min-width: 64rem) {
    .bar {
      padding: 0 8px 0 24px;
      gap: 20px;
    }

    .brand {
      margin-right: 0;
    }

    .brand img {
      height: 44px;
    }

    .site-header.is-scrolled .bar {
      height: 58px;
    }

    .site-header.is-scrolled .brand img {
      height: 40px;
    }

    .mobile-actions {
      display: none;
    }

    .nav {
      display: block;
      margin-inline: auto;
    }

    .nav__list {
      display: flex;
      align-items: center;
      gap: clamp(4px, 1vw, 14px);
    }

    .nav__item {
      position: relative;
    }

    .nav__link {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      min-height: 48px;
      padding: 0 12px;
      border: 0;
      border-radius: var(--r-pill);
      background: none;
      font-family: var(--font-body);
      font-size: 1rem;
      font-weight: 650;
      color: var(--ink);
      text-decoration: none;
      transition: color var(--dur-fast) var(--ease-out);
    }

    /* Diegs zem saites: „ieduras” no kreisās uz labo pusi */
    .nav__link::after {
      content: '';
      position: absolute;
      left: 12px;
      right: 12px;
      bottom: 9px;
      height: 1.5px;
      border-radius: 2px;
      background: var(--thread);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform var(--dur) var(--ease-out);
    }

    .nav__toggle::after {
      right: 30px;
    }

    .nav__link:hover {
      color: var(--chocolate);
    }

    .nav__link:hover::after,
    .nav__link.is-current::after {
      transform: scaleX(1);
    }

    .nav__chevron {
      transition: transform var(--dur) var(--ease-out);
    }

    .nav__toggle[aria-expanded='true'] .nav__chevron {
      transform: rotate(180deg);
    }

    .dropdown {
      position: absolute;
      top: calc(100% + 14px);
      left: 50%;
      width: 300px;
      padding: 10px;
      border-radius: 22px;
      background: var(--cream);
      box-shadow:
        inset 0 0 0 1px rgb(82 27 16 / 0.08),
        var(--shadow-lift);
      opacity: 0;
      visibility: hidden;
      transform: translate(-50%, -6px);
      transition:
        opacity var(--dur) var(--ease-out),
        transform var(--dur) var(--ease-out),
        visibility 0s linear var(--dur);
    }

    /* Tilts starp pogu un paneli, lai hover nepazūd */
    .dropdown::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: -16px;
      height: 16px;
    }

    :global(html.no-js) .nav__item--has-menu:focus-within .dropdown,
    .nav__item--has-menu.is-open .dropdown {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0);
      transition-delay: 0s;
    }

    @media (hover: hover) {
      .nav__item--has-menu:hover .dropdown {
        opacity: 1;
        visibility: visible;
        transform: translate(-50%, 0);
        transition-delay: 0s;
      }
    }

    .dropdown__link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      min-height: 48px;
      padding: 8px 14px;
      border-radius: 14px;
      font-family: var(--font-display);
      font-size: 1.125rem;
      font-weight: 420;
      color: var(--chocolate);
      text-decoration: none;
    }

    .dropdown__arrow {
      color: var(--thread);
      opacity: 0;
      transform: translateX(-6px);
      transition:
        opacity var(--dur) var(--ease-out),
        transform var(--dur) var(--ease-out);
    }

    .dropdown__link:hover,
    .dropdown__link:focus-visible,
    .dropdown__link[aria-current='page'] {
      background: var(--linen);
      color: var(--chocolate);
    }

    .dropdown__link:hover .dropdown__arrow,
    .dropdown__link:focus-visible .dropdown__arrow {
      opacity: 1;
      transform: none;
    }

    .phone {
      position: relative;
      display: none;
      align-items: center;
      gap: 7px;
      min-height: 48px;
      padding: 0 4px 0 20px;
      font-weight: 700;
      font-size: 1rem;
      color: var(--chocolate);
      text-decoration: none;
      white-space: nowrap;
      font-variant-numeric: lining-nums tabular-nums;
    }

    .phone::before {
      content: '';
      position: absolute;
      left: 0;
      top: 50%;
      width: 1px;
      height: 22px;
      translate: 0 -50%;
      background: var(--hairline-strong);
    }

    .phone :global(svg) {
      color: var(--thread);
    }

    .phone:hover {
      color: var(--rose-ink);
    }

    @media (min-width: 77.5rem) {
      .phone {
        display: inline-flex;
      }
    }

    .call {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      min-height: 48px;
      padding: 0 22px 0 18px;
      border-radius: var(--r-pill);
      background: var(--rose-cta);
      color: #fff;
      font-weight: 700;
      font-size: 1rem;
      text-decoration: none;
      white-space: nowrap;
      position: relative;
      isolation: isolate;
      transition: background-color var(--dur) var(--ease-out);
    }

    .call::after {
      content: '';
      position: absolute;
      inset: 4px;
      z-index: -1;
      border-radius: inherit;
      border: 1px dashed rgb(255 255 255 / 0.4);
      transition: inset var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out);
    }

    .call:hover {
      background: var(--rose-cta-hover);
      color: #fff;
    }

    .call:hover::after {
      inset: 3px;
      border-color: rgb(255 255 255 / 0.62);
    }
  }

  /* Pilnekrāna izvēlne */
  .sheet {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--cream);
    color: var(--ink);
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transform: translateY(-10px);
    transition:
      opacity 360ms var(--ease-out),
      transform 360ms var(--ease-out),
      overlay 360ms allow-discrete,
      display 360ms allow-discrete;
  }

  .sheet[open] {
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .sheet[open] {
      opacity: 0;
      transform: translateY(-10px);
    }
  }

  .sheet::backdrop {
    background: rgb(58 42 38 / 0.2);
  }

  .sheet__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: var(--header-top) calc(var(--header-side) + 6px) 0;
    background: var(--cream);
  }

  /* Ļoti smalks lina graudainums arī izvēlnē */
  .sheet__inner::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--grain);
    background-size: 180px;
    opacity: 0.05;
    pointer-events: none;
  }

  .sheet__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    padding-left: 10px;
  }

  .sheet__top .brand img {
    height: 34px;
  }

  .sheet__nav {
    padding: 28px 10px 24px;
  }

  .sheet__nav > ul > li + li {
    border-top: 1px solid var(--hairline);
  }

  .sheet__link {
    display: flex;
    align-items: center;
    min-height: 60px;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.4rem + 1.6vw, 2.25rem);
    font-weight: 400;
    line-height: 1.1;
    color: var(--chocolate);
    text-decoration: none;
  }

  .sheet__link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--thread);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.2em;
  }

  .sheet__group {
    padding: 14px 0 12px;
  }

  .sheet__label {
    display: block;
    margin-bottom: 4px;
    color: var(--ink-soft);
  }

  .sheet__sub a {
    display: flex;
    align-items: center;
    min-height: 46px;
    padding-left: 2px;
    font-family: var(--font-display);
    font-size: 1.3125rem;
    color: var(--chocolate);
    text-decoration: none;
  }

  .sheet__sub a[aria-current='page'] {
    color: var(--rose-ink);
  }

  /* Zvanīt un WhatsApp vienmēr redzami izvēlnes apakšā, arī uz zemiem ekrāniem */
  .sheet__contact {
    position: sticky;
    bottom: 0;
    z-index: 1;
    margin: auto calc(-1 * (var(--header-side) + 6px)) 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 18px calc(var(--header-side) + 10px) calc(14px + env(safe-area-inset-bottom));
    background: linear-gradient(180deg, rgb(250 245 238 / 0), var(--cream) 18px);
  }

  .sheet__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 56px;
    padding: 8px 14px;
    border-radius: var(--r-pill);
    font-weight: 700;
    text-decoration: none;
  }

  .sheet__btn--call {
    grid-column: 1 / -1;
    background: var(--rose-cta);
    color: #fff;
  }

  .sheet__num {
    font-weight: 600;
    opacity: 0.92;
  }

  .sheet__btn--wa {
    grid-column: 1 / -1;
    color: var(--chocolate);
    box-shadow: inset 0 0 0 1.5px rgb(82 27 16 / 0.55);
  }

  .sheet__meta {
    grid-column: 1 / -1;
    margin-top: 6px;
    text-align: center;
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }

  @media (min-width: 64rem) {
    .sheet {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');

  // 1) Ritinot galvene nedaudz sarūk un kļūst necaurspīdīgāka.
  if (header) {
    let ticking = false;
    const update = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 24);
      ticking = false;
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }

  // 1b) Virs tumšās kājenes plīvurs maina krāsu.
  const footer = document.getElementById('kajene');
  if (header && footer && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      ([entry]) => header.classList.toggle('is-over-dark', entry.isIntersecting),
      { rootMargin: '0px 0px -94% 0px' },
    ).observe(footer);
  }

  // 2) „Pakalpojumi” nolaižamā izvēlne (klikšķis, tastatūra, Escape).
  document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((item) => {
    const toggle = item.querySelector<HTMLButtonElement>('button');
    if (!toggle) return;
    const panel = item.querySelector<HTMLElement>('.dropdown');
    const setOpen = (open: boolean) => {
      item.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      // Aizvērta paneļa saites uzreiz izņem no tabulācijas (arī aizvēršanas animācijas laikā).
      if (panel) panel.inert = !open;
    };
    setOpen(false);
    const hovering = () => window.matchMedia('(hover: hover)').matches && item.matches(':hover');
    // Ar peli panelis jau atvērts (hover) - klikšķis to neaizver „neredzami”.
    toggle.addEventListener('click', () => setOpen(hovering() || toggle.getAttribute('aria-expanded') !== 'true'));
    item.addEventListener('mouseenter', () => {
      if (window.matchMedia('(hover: hover)').matches) setOpen(true);
    });
    item.addEventListener('mouseleave', () => setOpen(false));
    item.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        setOpen(false);
        toggle.focus();
      }
    });
    item.addEventListener('focusout', (e) => {
      if (!item.contains(e.relatedTarget as Node | null)) setOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (!item.contains(e.target as Node)) setOpen(false);
    });
  });

  // 3) Pilnekrāna izvēlne (<dialog>): fokuss, Escape, apakšējā josla paslēpta.
  const sheet = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openers = document.querySelectorAll<HTMLElement>('[data-menu-open]');
  if (sheet && typeof sheet.showModal === 'function') {
    openers.forEach((opener) => {
      // Ar JS saite kļūst par pogu (bez JS tā ved uz kājenes izvēlni).
      opener.setAttribute('role', 'button');
      opener.setAttribute('aria-expanded', 'false');
      opener.removeAttribute('aria-controls');
      opener.addEventListener('click', (e) => {
        e.preventDefault();
        sheet.showModal();
        document.documentElement.classList.add('menu-open');
        opener.setAttribute('aria-expanded', 'true');
      });
      opener.addEventListener('keydown', (e) => {
        if (e.key === ' ') {
          e.preventDefault();
          opener.click();
        }
      });
    });
    const close = () => sheet.close();
    sheet.querySelector('[data-menu-close]')?.addEventListener('click', close);
    sheet.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) close();
    });
    sheet.addEventListener('close', () => {
      document.documentElement.classList.remove('menu-open');
      openers.forEach((o) => o.setAttribute('aria-expanded', 'false'));
    });
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
      if (e.matches && sheet.open) close();
    });
  }
</script>
