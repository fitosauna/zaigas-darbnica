---
/**
 * Ceļvedis iekšlapās: „Sākums › Apģērbu remonts”. Pēdējais solis ir pašreizējā lapa.
 * BreadcrumbList JSON-LD veido lapa (src/lib/schema.ts → breadcrumbs()).
 */
interface Props {
  items: { name: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Navigācijas ceļš">
  <ol role="list">
    {
      items.map((item, i) =>
        i < items.length - 1 && item.href ? (
          <li>
            <a href={item.href}>{item.name}</a>
          </li>
        ) : (
          <li>
            <span aria-current="page">{item.name}</span>
          </li>
        ),
      )
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--ink-soft);
  }

  /* Atdalītājs - divi īsi dūrieni diega krāsā */
  .crumbs li + li::before {
    content: '';
    display: inline-block;
    width: 16px;
    height: 1.5px;
    margin: 0 10px 0.28em;
    vertical-align: middle;
    background: repeating-linear-gradient(90deg, var(--thread) 0 5px, transparent 5px 9px);
  }

  .crumbs a {
    display: inline-block;
    padding: 12px 0;
    margin: -12px 0;
    color: var(--rose-ink);
    font-weight: 650;
    text-decoration: underline;
    text-decoration-color: rgb(143 63 58 / 0.35);
  }

  .crumbs a:hover {
    color: var(--chocolate);
    text-decoration-color: currentColor;
  }

  .crumbs [aria-current] {
    font-weight: 600;
  }
</style>
