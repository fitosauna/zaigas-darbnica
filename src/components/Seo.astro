---
/** <head> meta: title, apraksts, canonical, Open Graph, Twitter. */
import { absoluteUrl, site } from '../config';

interface Props {
  title: string;
  description: string;
  /** Lapas ceļš, piem. '/' vai '/cenas'. */
  path: string;
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;
const canonical = absoluteUrl(path);
const ogImage = absoluteUrl('/og-image.jpg');
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

<meta property="og:type" content="website" />
<meta property="og:locale" content={site.locale} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Zaigas darbnīca Alūksnē - šūšana un adīšana" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
