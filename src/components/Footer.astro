---
/**
 * Kājene: šokolādes „odere” ar maigu izliektu vīli un dūrienu līniju.
 * Trīs kolonnas: logo, sauklis, darba laiks; telefonā viens zem otra centrā.
 * Kontakti jau ir galvenē, noslēgumā un apakšējā joslā.
 */
import { hours, site } from '../config';
import { logos } from '../data/images';
import { mainNav } from '../data/navigation';
import { buildLogo } from '../lib/picture';

// logo-cream.png ir ~16% caurspīdīgas malas augšā/apakšā; tās nogriežam ar object-fit (bez pārzīmēšanas).
const logo = await buildLogo(logos.fullCream.src, 150);
const year = new Date().getFullYear();
const services = mainNav.find((n) => n.children)?.children ?? [];
const pages = mainNav.filter((n) => !n.children);
---

<footer class="footer" id="kajene">
  <svg class="footer__seam" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path class="footer__seam-fill" d="M0 56 Q720 -40 1440 56 V80 H0 Z"></path>
    <path class="footer__seam-stitch" d="M0 70 Q720 -26 1440 70"></path>
  </svg>
  <div class="container footer__grid">
    <a href="/" class="footer__logo">
      <img
        src={logo.src}
        srcset={logo.srcset}
        width={logo.width}
        height={logo.height}
        alt={`${site.name} - sākumlapa`}
        loading="lazy"
        decoding="async"
      />
    </a>

    <p class="footer__motto">Ar sirdi darināts.<br />Ar prieku valkāts.</p>

    <div class="footer__hours">
      <p class="footer__label">Darba laiks</p>
      <p>{hours.daysLong}</p>
      <p>{hours.time}</p>
      <p>Svētdien slēgts</p>
    </div>

    <!-- Bez JavaScript izvēlnes poga galvenē ved šurp -->
    <nav class="footer__nojs" id="kajenes-izvelne" aria-label="Kājenes izvēlne">
      <ul role="list">
        {
          [...services, ...pages].map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container footer__base">
    <p>©&nbsp;{year} {site.name}</p>
    <a href="/privatuma-politika">Privātuma politika</a>
  </div>
</footer>

<style>
  .footer {
    --curve: clamp(28px, 4vw, 56px);
    position: relative;
    overflow-x: clip;
    padding: calc(var(--section-tight) * 0.55) 0 calc(var(--s-4) + var(--bottom-bar-h));
    background: var(--chocolate);
    color: var(--on-dark);
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  /* Maigi izliekta vīle ar dūrieniem: viena līkne no malas līdz malai */
  .footer__seam {
    position: absolute;
    left: 0;
    width: 100%;
    top: calc(-1 * var(--curve));
    height: calc(var(--curve) * 80 / 56);
    overflow: visible;
    pointer-events: none;
  }

  .footer__seam-fill {
    fill: var(--chocolate);
  }

  .footer__seam-stitch {
    fill: none;
    stroke: rgb(227 181 172 / 0.55);
    stroke-width: 1.5;
    stroke-dasharray: 6 6;
    vector-effect: non-scaling-stroke;
  }

  .footer__grid {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--s-5);
    text-align: center;
  }

  .footer a {
    color: var(--on-dark);
    text-decoration-color: rgb(227 181 172 / 0.6);
  }

  .footer a:hover {
    color: var(--on-dark-soft);
  }

  .footer :focus-visible {
    outline-color: var(--on-dark);
  }

  .footer__logo {
    display: inline-block;
    border-radius: 8px;
  }

  .footer__logo img {
    width: 200px;
    height: 107px;
    object-fit: cover;
    object-position: 50% 50%;
  }

  .footer__motto {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.375rem, 1.2rem + 0.7vw, 1.75rem);
    line-height: 1.3;
    text-align: center;
    color: var(--on-dark);
  }

  .footer__hours p + p {
    margin-top: 0.15em;
  }

  .footer__label {
    margin-bottom: 0.4em;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(250 245 238 / 0.7);
  }

  .footer__nojs {
    display: none;
  }

  :global(html.no-js) .footer__nojs {
    display: block;
  }

  .footer__nojs ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 var(--s-5);
  }

  .footer__nojs a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }

  .footer__base {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-top: var(--s-5);
    padding-top: var(--s-4);
    border-top: 1px solid rgb(250 245 238 / 0.14);
    color: rgb(250 245 238 / 0.78);
  }

  .footer__base a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: rgb(250 245 238 / 0.9);
  }

  @media (min-width: 64rem) {
    .footer__grid {
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: var(--s-4) var(--s-6);
    }

    .footer__logo {
      justify-self: start;
    }

    .footer__hours {
      justify-self: end;
      text-align: right;
    }

    .footer__nojs {
      grid-column: 1 / -1;
      justify-self: stretch;
    }

    .footer__base {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
