---
/**
 * Kājene: šokolādes „odere” ar maigu izliektu vīli un dūrienu līniju.
 * Teksts no Part B (kopējie elementi).
 */
import { contact, hours, links, owner, site } from '../config';
import { logos } from '../data/images';
import { mainNav } from '../data/navigation';
import { buildLogo } from '../lib/picture';
import Icon from './Icon.astro';

const logo = await buildLogo(logos.fullCream.src, 132);
const year = new Date().getFullYear();
const services = mainNav.find((n) => n.children)?.children ?? [];
const pages = mainNav.filter((n) => !n.children);
---

<footer class="footer" id="kajene">
  <div class="footer__seam" aria-hidden="true"></div>
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="/" class="footer__logo">
        <img
          src={logo.src}
          srcset={logo.srcset}
          width={logo.width}
          height={logo.height}
          alt={`${site.name} - sākumlapa`}
          loading="lazy"
          decoding="async"
        />
      </a>
      <p>
        {site.name} - šūšana un adīšana Alūksnē. Apģērbu remonts un pielāgošana, individuālā šūšana, adīšana pēc
        pasūtījuma, aizkari un mājas tekstils.
      </p>
    </div>

    <div class="footer__col">
      <h2 class="label footer__title">Kontakti</h2>
      <address>
        <p>{contact.address.street}, {contact.address.city}, <span class="nowrap">{contact.address.postalCode}</span></p>
        <p>
          Tālrunis un WhatsApp:<br />
          <a href={links.tel}>{contact.phoneDisplay}</a>
        </p>
        <p>
          E-pasts: <a href={links.mail}>{contact.email}</a>
        </p>
      </address>
      <ul role="list" class="footer__quick">
        <li>
          <a href={links.tel}><Icon name="phone" size={18} /> Zvanīt</a>
        </li>
        <li>
          <a href={links.whatsapp} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={18} /> WhatsApp</a>
        </li>
      </ul>
    </div>

    <div class="footer__col">
      <h2 class="label footer__title">Darba laiks</h2>
      <p><span class="nowrap">{hours.daysLong}</span> <span class="nowrap">{hours.time}</span>, {hours.closed}</p>
      <p>Klienti no Alūksnes, Gulbenes, Balviem un apkārtnes.</p>
      <p>Meistare: {owner.name}</p>
    </div>

    <nav class="footer__col" id="kajenes-izvelne" aria-label="Kājenes izvēlne">
      <h2 class="label footer__title">Pakalpojumi</h2>
      <ul role="list" class="footer__links">
        {
          services.map((s) => (
            <li>
              <a href={s.href}>{s.label}</a>
            </li>
          ))
        }
      </ul>
      <ul role="list" class="footer__links footer__links--pages">
        {
          pages.map((p) => (
            <li>
              <a href={p.href}>{p.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container footer__base">
    <p>© {year} {site.name} · <a href="/privatuma-politika">Privātuma politika</a></p>
  </div>
</footer>

<style>
  .footer {
    --curve: clamp(28px, 4vw, 56px);
    position: relative;
    overflow-x: clip;
    padding: calc(var(--section-tight) * 0.9) 0 calc(var(--s-6) + var(--bottom-bar-h));
    background: var(--chocolate);
    color: var(--on-dark);
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  /* Maigi izliekta vīle ar dūrieniem */
  .footer__seam {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(-1 * var(--curve));
    height: calc(var(--curve) * 2);
    background: var(--chocolate);
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    pointer-events: none;
  }

  .footer__seam::after {
    content: '';
    position: absolute;
    inset: 13px 0 auto;
    height: calc(var(--curve) * 2);
    border-top: 1.5px dashed rgb(227 181 172 / 0.55);
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  }

  .footer__grid {
    position: relative;
    display: grid;
    gap: var(--s-7) var(--s-6);
  }

  .footer p + p,
  .footer address p + p {
    margin-top: 0.6em;
  }

  .footer address {
    font-style: normal;
  }

  .footer a {
    color: var(--on-dark);
    text-decoration-color: rgb(227 181 172 / 0.6);
  }

  .footer a:hover {
    color: var(--on-dark-soft);
  }

  .footer :focus-visible {
    outline-color: var(--on-dark);
  }

  .footer__logo {
    display: inline-block;
    margin-bottom: var(--s-5);
    border-radius: 8px;
  }

  .footer__logo img {
    width: auto;
    height: 112px;
  }

  .footer__brand p {
    max-width: 38ch;
    color: rgb(250 245 238 / 0.86);
  }

  .footer__title {
    margin-bottom: var(--s-4);
    color: var(--on-dark-soft);
  }

  .footer__quick {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: var(--s-4);
  }

  .footer__quick a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 16px;
    border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1px rgb(250 245 238 / 0.35);
    text-decoration: none;
    font-weight: 700;
  }

  .footer__quick a:hover {
    box-shadow: inset 0 0 0 1px var(--on-dark);
    color: var(--on-dark);
  }

  .footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .footer__links a:hover {
    text-decoration: underline;
  }

  .footer__links--pages {
    margin-top: var(--s-4);
    padding-top: var(--s-3);
    border-top: 1px solid rgb(250 245 238 / 0.14);
  }

  .footer__base {
    margin-top: var(--s-8);
    padding-top: var(--s-5);
    border-top: 1px solid rgb(250 245 238 / 0.14);
    color: rgb(250 245 238 / 0.78);
  }

  .footer__base a {
    color: rgb(250 245 238 / 0.9);
  }

  @media (min-width: 48rem) {
    .footer__grid {
      grid-template-columns: 1.3fr 1fr;
    }
  }

  @media (min-width: 64rem) {
    .footer__grid {
      grid-template-columns: 1.35fr 1fr 1fr 0.95fr;
      gap: var(--s-6) clamp(2rem, 4vw, 4rem);
    }
  }
</style>
