---
/**
 * Kājene: šokolādes „odere” ar maigu izliektu vīli un dūrienu līniju.
 * Īsa: logo, kontakti un (darbvirsmā) pogas „Zvanīt” / „WhatsApp”;
 * telefonā pogu nav, jo tās jau ir apakšējā joslā.
 */
import { contact, links, site } from '../config';
import { logos } from '../data/images';
import { mainNav } from '../data/navigation';
import { buildLogo } from '../lib/picture';
import Icon from './Icon.astro';

// logo-cream.png ir ~16% caurspīdīgas malas augšā/apakšā; tās nogriežam ar object-fit (bez pārzīmēšanas).
const logo = await buildLogo(logos.fullCream.src, 150);
const year = new Date().getFullYear();
const services = mainNav.find((n) => n.children)?.children ?? [];
const pages = mainNav.filter((n) => !n.children);
---

<footer class="footer" id="kajene">
  <svg class="footer__seam" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path class="footer__seam-fill" d="M0 56 Q720 -40 1440 56 V80 H0 Z"></path>
    <path class="footer__seam-stitch" d="M0 70 Q720 -26 1440 70"></path>
  </svg>
  <div class="container footer__grid">
    <a href="/" class="footer__logo">
      <img
        src={logo.src}
        srcset={logo.srcset}
        width={logo.width}
        height={logo.height}
        alt={`${site.name} - sākumlapa`}
        loading="lazy"
        decoding="async"
      />
    </a>

    <address class="footer__contacts">
      <p>{contact.address.street}, {contact.address.city}, <span class="nowrap">{contact.address.postalCode}</span></p>
      <p><a href={links.tel}>{contact.phoneDisplay}</a></p>
      <p><a href={links.mail}>{contact.email}</a></p>
    </address>

    <ul role="list" class="footer__quick" data-primary-actions>
      <li>
        <a href={links.tel}><Icon name="phone" size={18} /> Zvanīt</a>
      </li>
      <li>
        <a href={links.whatsapp} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={18} /> WhatsApp</a>
      </li>
    </ul>

    <!-- Bez JavaScript izvēlnes poga galvenē ved šurp -->
    <nav class="footer__nojs" id="kajenes-izvelne" aria-label="Kājenes izvēlne">
      <ul role="list">
        {
          [...services, ...pages].map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container footer__base">
    <p>©&nbsp;{year} {site.name}</p>
    <a href="/privatuma-politika">Privātuma politika</a>
  </div>
</footer>

<style>
  .footer {
    --curve: clamp(28px, 4vw, 56px);
    position: relative;
    overflow-x: clip;
    padding: calc(var(--section-tight) * 0.55) 0 calc(var(--s-4) + var(--bottom-bar-h));
    background: var(--chocolate);
    color: var(--on-dark);
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  /* Maigi izliekta vīle ar dūrieniem: viena līkne no malas līdz malai */
  .footer__seam {
    position: absolute;
    left: 0;
    width: 100%;
    top: calc(-1 * var(--curve));
    height: calc(var(--curve) * 80 / 56);
    overflow: visible;
    pointer-events: none;
  }

  .footer__seam-fill {
    fill: var(--chocolate);
  }

  .footer__seam-stitch {
    fill: none;
    stroke: rgb(227 181 172 / 0.55);
    stroke-width: 1.5;
    stroke-dasharray: 6 6;
    vector-effect: non-scaling-stroke;
  }

  .footer__grid {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--s-5);
    text-align: center;
  }

  .footer a {
    color: var(--on-dark);
    text-decoration-color: rgb(227 181 172 / 0.6);
  }

  .footer a:hover {
    color: var(--on-dark-soft);
  }

  .footer :focus-visible {
    outline-color: var(--on-dark);
  }

  .footer__logo {
    display: inline-block;
    border-radius: 8px;
  }

  .footer__logo img {
    width: 200px;
    height: 107px;
    object-fit: cover;
    object-position: 50% 50%;
  }

  .footer__contacts {
    font-style: normal;
  }

  .footer__contacts p + p {
    margin-top: 0.35em;
  }

  .footer__contacts a {
    display: inline-block;
    padding: 6px 0;
    margin: -6px 0;
    font-weight: 650;
  }

  /* Telefonā pogu nav - zvanīt/WhatsApp jau ir apakšējā joslā */
  .footer__quick {
    display: none;
  }

  .footer__quick a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 50px;
    padding: 0 22px;
    border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1.5px rgb(250 245 238 / 0.4);
    text-decoration: none;
    font-weight: 700;
    transition: box-shadow var(--dur) var(--ease-out), background-color var(--dur) var(--ease-out);
  }

  .footer__quick a:hover {
    color: var(--on-dark);
    background: rgb(250 245 238 / 0.08);
    box-shadow: inset 0 0 0 1.5px var(--on-dark);
  }

  .footer__nojs {
    display: none;
  }

  :global(html.no-js) .footer__nojs {
    display: block;
  }

  .footer__nojs ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 var(--s-5);
  }

  .footer__nojs a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }

  .footer__base {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-top: var(--s-6);
    padding-top: var(--s-4);
    border-top: 1px solid rgb(250 245 238 / 0.14);
    color: rgb(250 245 238 / 0.78);
  }

  .footer__base a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: rgb(250 245 238 / 0.9);
  }

  @media (min-width: 64rem) {
    .footer__grid {
      grid-template-columns: 1fr 1fr 1fr;
      align-items: center;
      justify-items: start;
      gap: var(--s-6);
      text-align: left;
    }

    .footer__quick {
      display: flex;
      gap: 12px;
      justify-self: end;
    }

    .footer__nojs {
      grid-column: 1 / -1;
    }

    .footer__base {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
