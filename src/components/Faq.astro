---
/**
 * Biežāk uzdotie jautājumi - <details>/<summary> (darbojas arī bez JS).
 * Atkārtoti lietojams komponents visām lapām.
 */
import type { Faq } from '../data/faq';

interface Props {
  title: string;
  items: Faq[];
  id?: string;
  label?: string;
  /** Fona toņi (iekšlapās pēc iepriekšējās sadaļas). Noklusēti: krēms → rožains. */
  tones?: { from: string; tone: string; to: string };
}
const { title, items, id = 'buj', label, tones } = Astro.props;
const style = tones ? `--from: var(--${tones.from}); --tone: var(--${tones.tone}); --to: var(--${tones.to})` : undefined;
---

<section class="faq tone" aria-labelledby={`${id}-title`} style={style}>
  <div class="container faq__grid grid-12">
    <div class="faq__head">
      {label && <p class="label">{label}</p>}
      <h2 id={`${id}-title`}>{title}</h2>
    </div>
    <div class="faq__list">
      {
        items.map((f) => (
          <details class="faq__item">
            <summary>
              <span class="faq__q">{f.q}</span>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            {f.html ? <p class="faq__a" set:html={f.a} /> : <p class="faq__a">{f.a}</p>}
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    --from: var(--cream);
    --tone: var(--cream);
    --to: var(--blush);
    padding: var(--section-tight) 0 var(--section);
  }

  .faq__grid {
    display: grid;
    gap: var(--s-7);
  }

  .faq__head h2 {
    max-width: 12ch;
  }

  .faq__head .label + h2 {
    margin-top: var(--s-3);
  }

  .faq__list {
    border-top: 1px solid var(--hairline-strong);
  }

  .faq__item {
    border-bottom: 1px solid var(--hairline-strong);
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    min-height: 64px;
    padding: var(--s-4) 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: clamp(1.1875rem, 1.1rem + 0.4vw, 1.4375rem);
    font-weight: 450;
    line-height: 1.3;
    color: var(--chocolate);
    -webkit-tap-highlight-color: transparent;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__q {
    text-wrap: balance;
  }

  .faq__item summary:hover .faq__q {
    color: var(--rose-ink);
  }

  /* „+” kā krustdūriens, atverot pārtop par „-” */
  .faq__icon {
    position: relative;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(82 27 16 / 0.25);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.5px;
    margin: -0.75px 0 0 -6px;
    background: var(--thread);
    transition: transform var(--dur) var(--ease-out);
  }

  .faq__icon::after {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__icon::after {
    transform: rotate(0deg);
  }

  .faq__a {
    max-width: 60ch;
    padding: 0 var(--s-8) var(--s-5) 0;
    color: var(--ink);
  }

  @media (min-width: 64rem) {
    .faq__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 0 var(--s-6);
      align-items: start;
    }

    .faq__head {
      grid-column: 1 / span 4;
      position: sticky;
      top: calc(var(--header-top) + var(--header-h) + 40px);
    }

    .faq__list {
      grid-column: 6 / -1;
    }
  }
</style>
