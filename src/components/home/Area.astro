---
/** 1.9 Teritorija - Alūksne, Gulbene, Balvi. */
import { contact } from '../../config';
import { typo } from '../../lib/typo';
---

<section class="area tone" aria-labelledby="area-title">
  <div class="container area__grid grid-12">
    <h2 id="area-title" class="area__title">Šuvēja Alūksnē&nbsp;- arī Gulbenes un Balvu klientiem</h2>
    <ul role="list" class="area__places" aria-hidden="true">
      <li class="area__town area__town--home">Alūksne</li>
      <li class="area__town">Gulbene</li>
      <li class="area__town">Balvi</li>
    </ul>
    <p class="area__text">
      Mana darbnīca atrodas Alūksnē, {typo(contact.address.streetLocative)}. Pie manis brauc klienti arī no Gulbenes,
      Balviem un apkārtējiem pagastiem. Ja braucat no tālienes, vispirms atsūtiet foto, lai jau iepriekš zinātu, vai
      darbu var izdarīt un cik tas maksās. Ja iespējams, atvediet vairākas lietas uzreiz.
    </p>
  </div>
</section>

<style>
  .area {
    --from: var(--cream);
    --tone: var(--linen);
    --to: var(--cream);
    padding: var(--section) 0;
  }

  .area__grid {
    display: grid;
    gap: var(--s-5);
  }

  .area__title {
    max-width: 18ch;
  }

  .area__places {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.6em;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem);
    line-height: 1.2;
  }

  .area__town {
    font-weight: 380;
    color: var(--ink-soft);
  }

  .area__town--home {
    font-style: italic;
    font-weight: 400;
    color: var(--chocolate);
  }

  .area__town + .area__town::before {
    content: '·';
    margin-right: 0.6em;
    color: var(--thread);
  }

  .area__text {
    max-width: 56ch;
  }

  @media (min-width: 64rem) {
    .area__grid {
      grid-template-rows: auto auto 1fr;
      gap: 0 var(--s-6);
      align-items: start;
    }

    .area__places {
      grid-column: 1 / span 4;
      grid-row: 1 / span 3;
      flex-direction: column;
      gap: 0.1em;
      padding-top: 0.35em;
    }

    .area__town + .area__town::before {
      content: none;
    }

    .area__title,
    .area__text {
      grid-column: 6 / -1;
    }

    .area__text {
      margin-top: var(--s-5);
    }
  }
</style>
