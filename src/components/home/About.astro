---
/**
 * 1.5 Par Zaigu - portrets arkveida, spoguļa rāmī ar mazu rokrakstā
 * rakstītu parakstu (A5). Bilde ar īsto Zaigu - teksts runā par Zaigu.
 */
import Picture from '../Picture.astro';
import Button from '../Button.astro';
import { images } from '../../data/images';
---

<section class="about tone" aria-labelledby="about-title">
  <div class="container about__grid grid-12">
    <figure class="about__portrait">
      <div class="arch">
        <div class="arch__glass">
          <Picture
            image={images.zaigaPortrets}
            widths={[360, 520, 720, 960, 1122]}
            sizes="(min-width: 64rem) 30vw, (min-width: 43.75rem) 52vw, 80vw"
          />
        </div>
      </div>
      <span class="about__sign hand" aria-hidden="true">Zaiga</span>
    </figure>

    <div class="about__copy">
      <h2 id="about-title">Iepazīsimies! Esmu Zaiga</h2>
      <p class="about__text">
        Esmu Zaiga Lemeševska, šuvēja un adītāja no Alūksnes. Adīt mani jau bērnībā iemācīja mamma, bet šūšana vēlāk
        kļuva par manu sirdslietu. Kad apsēžos pie šujmašīnas, šķiet, ka pasaule uz brīdi apstājas, tik ļoti mēdzu
        aizrauties ar darbu.
      </p>
      <Button href="/par-mani#stasts" variant="secondary" arrow>Izlasīt manu stāstu</Button>
    </div>
  </div>
</section>

<style>
  .about {
    --from: var(--blush);
    --tone: var(--blush);
    --to: var(--cream);
    padding: var(--section-tight) 0 var(--section);
  }

  .about__grid {
    display: grid;
    gap: var(--s-8);
    align-items: center;
  }

  .about__portrait {
    position: relative;
    width: min(100%, 25rem);
    margin-inline: auto;
  }

  /* Arka ar plānu spoguļa rāmi */
  .arch {
    padding: 12px;
    border-radius: 999px 999px 20px 20px;
    background: linear-gradient(160deg, rgb(255 252 247 / 0.9), rgb(241 230 216 / 0.7));
    box-shadow:
      inset 0 0 0 1px rgb(82 27 16 / 0.16),
      0 1px 2px rgb(82 27 16 / 0.05),
      0 30px 60px -36px rgb(82 27 16 / 0.55);
  }

  .arch__glass {
    position: relative;
    overflow: hidden;
    border-radius: 999px 999px 12px 12px;
    box-shadow: inset 0 0 0 1px rgb(82 27 16 / 0.12);
  }

  .arch__glass :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5.2;
    object-fit: cover;
    object-position: 50% 30%;
  }

  /* Viegls spoguļa atspīdums */
  .arch__glass::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(125deg, rgb(255 255 255 / 0.22) 0%, rgb(255 255 255 / 0) 34%);
    pointer-events: none;
  }

  .about__sign {
    position: absolute;
    right: -0.2em;
    bottom: -0.55em;
    font-size: clamp(3rem, 2.4rem + 2.4vw, 4.25rem);
    color: var(--thread);
    transform: rotate(-8deg);
  }

  .about__copy h2 {
    max-width: 14ch;
  }

  .about__text {
    margin-top: var(--s-5);
    max-width: 54ch;
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  .about__copy :global(.btn) {
    margin-top: var(--s-6);
  }

  @media (min-width: 64rem) {
    .about__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 0 var(--s-6);
    }

    /* Portrets pārkāpj vīli uz iepriekšējo sadaļu, kā uz dēļa uzlikta fotogrāfija */
    .about__portrait {
      grid-column: 1 / span 5;
      width: 100%;
      max-width: 27rem;
      margin: calc(-1 * var(--s-9)) 0 0 auto;
    }

    .about__copy {
      grid-column: 7 / -1;
    }
  }
</style>
