---
/**
 * Kontaktinformācija (Part B §9.2) kā vizītkarte: papīrs ar iešūtu dūrienu malu.
 * Katrs tālrunis ir tel: saite; WhatsApp - ar pogu (DESIGN.md #13).
 */
import Button from '../Button.astro';
import { contact, links } from '../../config';
import { kontakti } from '../../data/pages/kontakti';
---

<section class="card" aria-labelledby="kontaktinformacija-title">
  <h2 id="kontaktinformacija-title" class="label card__title">{kontakti.info.title}</h2>
  <p class="card__name">
    <strong>{kontakti.info.business}</strong>&nbsp;- {kontakti.info.master}
  </p>
  <dl class="card__list">
    <div>
      <dt>Tālrunis</dt>
      <dd><a href={links.tel}>{contact.phoneDisplay}</a></dd>
    </div>
    <div>
      <dt><a href={links.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a></dt>
      <dd><a href={links.tel}>{contact.phoneDisplay}</a>&nbsp;- {kontakti.info.whatsappNote}</dd>
    </div>
    <div>
      <dt>E-pasts</dt>
      <dd><a href={links.mail}>{contact.email}</a></dd>
    </div>
    <div>
      <dt>Darbnīca</dt>
      <dd>
        Tālavas iela&nbsp;18, {contact.address.city}, <span class="nowrap">{contact.address.postalCode}</span>
      </dd>
    </div>
  </dl>
  <div class="card__actions" data-primary-actions>
    <Button href={links.tel} icon="phone">Zvanīt Zaigai</Button>
    <Button href={links.whatsapp} icon="whatsapp" variant="secondary" external>Rakstīt WhatsApp</Button>
    <Button href={links.mail} icon="mail" variant="quiet">Rakstīt e-pastu</Button>
  </div>
</section>

<style>
  .card {
    position: relative;
    padding: clamp(24px, 1rem + 2.4vw, 44px);
    border-radius: var(--r-l);
    background: var(--paper);
    box-shadow: var(--shadow-lift);
  }

  /* Iešūta dūrienu mala */
  .card::before {
    content: '';
    position: absolute;
    inset: 9px;
    border: 1.5px dashed rgb(184 96 90 / 0.38);
    border-radius: calc(var(--r-l) - 8px);
    pointer-events: none;
  }

  .card__title {
    color: var(--rose-ink);
    font-size: var(--fs-label);
    letter-spacing: 0.22em;
  }

  .card__name {
    margin-top: var(--s-3);
    font-family: var(--font-display);
    font-size: clamp(1.3125rem, 1.15rem + 0.6vw, 1.625rem);
    line-height: 1.3;
    color: var(--chocolate);
  }

  .card__name strong {
    font-weight: 500;
  }

  .card__list {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-5);
  }

  .card__list > div {
    display: grid;
    gap: 2px;
  }

  .card__list dt {
    font-size: var(--fs-small);
    font-weight: 750;
    color: var(--chocolate);
  }

  .card__list a {
    display: inline-block;
    padding: 10px 0;
    margin: -10px 0;
    font-weight: 700;
    white-space: nowrap;
  }

  .card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 14px;
    margin-top: var(--s-6);
  }

  .card__list dt a {
    padding: 10px 0;
    margin: -10px 0;
    font-weight: 750;
  }

  @media (max-width: 29.99rem) {
    .card__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }

  @media (min-width: 30rem) {
    .card__list > div {
      grid-template-columns: 6.5rem 1fr;
      gap: var(--s-4);
    }
  }
</style>
