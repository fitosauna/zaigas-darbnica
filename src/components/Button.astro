---
/**
 * Poga-saite. Variants:
 *  - primary: rozā ar baltu tekstu un smalku iekšējo „dūrienu” līniju (kā šūta etiķete)
 *  - secondary: caurspīdīga ar šokolādes kontūru
 *  - quiet: teksta saite ar bultiņu
 *  - light: uz tumša fona
 */
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

type IconName = 'phone' | 'whatsapp' | 'arrow' | 'mail';

interface Props extends Omit<HTMLAttributes<'a'>, 'class'> {
  href: string;
  variant?: 'primary' | 'secondary' | 'quiet' | 'light';
  size?: 'md' | 'lg';
  icon?: IconName;
  arrow?: boolean;
  external?: boolean;
  block?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  arrow = false,
  external = false,
  block = false,
  class: className,
  ...rest
} = Astro.props;

const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, { 'btn--block': block }, className]}
  {...externalAttrs}
  {...rest}
>
  {icon && <Icon name={icon} size={size === 'lg' ? 22 : 20} class="btn__icon" />}
  <span class="btn__label"><slot /></span>
  {arrow && <Icon name="arrow" size={20} class="btn__arrow" />}
</a>

<style>
  .btn {
    --btn-h: 52px;
    --btn-px: 26px;
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: var(--btn-h);
    padding: 10px var(--btn-px);
    border-radius: var(--r-pill);
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: 0.005em;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .btn--lg {
    --btn-h: 58px;
    --btn-px: 30px;
    font-size: 1.125rem;
  }

  .btn--block {
    display: flex;
    width: 100%;
  }

  .btn:active {
    transform: translateY(1px);
  }

  .btn__label {
    white-space: normal;
  }

  .btn__icon {
    flex: none;
  }

  .btn__arrow {
    flex: none;
    transition: transform var(--dur) var(--ease-out);
  }

  .btn:hover .btn__arrow {
    transform: translateX(3px);
  }

  /* Primārā: rozā ar šūtas etiķetes dūrieniem iekšpusē */
  .btn--primary {
    background: var(--rose-cta);
    color: #fff;
    box-shadow: 0 1px 1px rgb(82 27 16 / 0.12), 0 10px 24px -14px rgb(158 74 69 / 0.9);
  }

  .btn--primary::after {
    content: '';
    position: absolute;
    inset: 4px;
    z-index: -1;
    border-radius: inherit;
    border: 1px dashed rgb(255 255 255 / 0.4);
    transition:
      inset var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .btn--primary:hover {
    background: var(--rose-cta-hover);
    color: #fff;
  }

  /* „Diegs savelkas”: dūrieni pievelkas tuvāk malai */
  .btn--primary:hover::after {
    inset: 3px;
    border-color: rgb(255 255 255 / 0.62);
  }

  .btn--secondary {
    background: rgb(250 245 238 / 0.55);
    color: var(--chocolate);
    box-shadow: inset 0 0 0 1.5px rgb(82 27 16 / 0.55);
  }

  .btn--secondary:hover {
    background: var(--cream);
    color: var(--chocolate);
    box-shadow: inset 0 0 0 1.5px var(--chocolate);
  }

  .btn--light {
    background: var(--cream);
    color: var(--chocolate);
  }

  .btn--light:hover {
    background: #fff;
    color: var(--chocolate);
  }

  .btn--quiet {
    --btn-px: 2px;
    min-height: 48px;
    border-radius: 6px;
    color: var(--rose-ink);
    background: none;
    font-weight: 700;
  }

  .btn--quiet .btn__label {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 100% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    padding-bottom: 2px;
  }

  .btn--quiet:hover {
    color: var(--chocolate);
  }
</style>
