---
/** Vienkāršas līniju ikonas (inline SVG, currentColor). Bez emocijzīmēm. */
interface Props {
  name: 'phone' | 'whatsapp' | 'arrow' | 'menu' | 'close' | 'chevron' | 'plus' | 'mail' | 'pin' | 'clock' | 'route' | 'camera';
  size?: number;
  class?: string;
  label?: string;
}
const { name, size = 20, class: className, label, ...rest } = Astro.props;
const scope = Object.fromEntries(Object.entries(rest).filter(([k]) => k.startsWith('data-astro-cid')));
const a11y = label ? { role: 'img' as const, 'aria-label': label } : { 'aria-hidden': 'true' as const };
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  focusable="false"
  {...scope}
  {...a11y}
>
  {
    name === 'phone' && (
      <path d="M8.2 3.6 6.1 3.9c-1 .2-1.8 1.1-1.7 2.2.5 7 6.5 13 13.5 13.5 1.1.1 2-.7 2.2-1.7l.3-2.1c.1-.6-.2-1.1-.7-1.4l-2.6-1.3c-.5-.3-1.1-.1-1.5.3l-1 1.2c-2.3-1-4.2-2.9-5.2-5.2l1.2-1c.4-.4.6-1 .3-1.5L9.6 4.3c-.3-.5-.8-.8-1.4-.7Z" />
    )
  }
  {
    name === 'whatsapp' && (
      <>
        <path d="M4.3 19.7 5.4 16A8.2 8.2 0 1 1 8.6 19l-4.3.7Z" />
        <path d="M9.3 8.6c.2-.4.6-.4.8-.1l.8 1.4c.1.3 0 .6-.2.8l-.4.4c.5 1.1 1.5 2 2.6 2.6l.4-.4c.2-.2.5-.3.8-.2l1.4.8c.3.2.3.6-.1.8-.6.5-1.4.7-2.2.4a7 7 0 0 1-4.3-4.3c-.3-.8-.1-1.6.4-2.2Z" stroke-width="1.3" />
      </>
    )
  }
  {name === 'arrow' && <path d="M4.5 12h14.5m-5.5-5.5L19 12l-5.5 5.5" />}
  {name === 'menu' && <path d="M4 8.5h16M4 15.5h11" />}
  {name === 'close' && <path d="m6 6 12 12M18 6 6 18" />}
  {name === 'chevron' && <path d="m6.5 9.5 5.5 5.5 5.5-5.5" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {
    name === 'mail' && (
      <>
        <rect x="3.5" y="5.5" width="17" height="13" rx="2" />
        <path d="m4.5 7 7.5 6 7.5-6" />
      </>
    )
  }
  {
    name === 'pin' && (
      <>
        <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" />
        <circle cx="12" cy="10" r="2.3" />
      </>
    )
  }
  {
    name === 'route' && (
      <>
        <circle cx="6" cy="18" r="2.2" />
        <circle cx="18" cy="6" r="2.2" />
        <path d="M8.2 18h6.3a3.2 3.2 0 0 0 0-6.4h-5a3.2 3.2 0 0 1 0-6.4h6.3" stroke-dasharray="2.2 2.2" />
      </>
    )
  }
  {
    name === 'camera' && (
      <>
        <path d="M4 8.5h3.2l1.5-2.5h6.6l1.5 2.5H20v10H4Z" />
        <circle cx="12" cy="13.2" r="3.1" />
      </>
    )
  }
  {
    name === 'clock' && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 7.5V12l3 2" />
      </>
    )
  }
</svg>
