---
/**
 * /privatuma-politika - Part B §10. Klusa teksta lapa.
 * „Spēkā no” rinda parādās tikai tad, kad src/config.ts ierakstīts site.privacyDate.
 * Papildināts viens teikums par karti lapā /kontakti (tā ielādējas no Google pēc klikšķa).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerHero from '../components/page/InnerHero.astro';
import { contact, links, owner, site } from '../config';
import { breadcrumbs } from '../lib/schema';
import { typo } from '../lib/typo';

const title = 'Privātuma politika | Zaigas darbnīca';
const description = 'Kā Zaigas darbnīca apstrādā kontaktformā un saziņā sniegtos personas datus.';
const mail = `<a href="${links.mail}">${contact.email}</a>`;
const tel = `<a href="${links.tel}">${contact.phoneDisplay}</a>`;

const parts: { lead: string; html: string }[] = [
  {
    lead: 'Pārzinis.',
    html: `Personas datus apstrādā ${owner.name} (${site.name}), ${typo(contact.address.street)}, ${contact.address.city}, <span class="nowrap">${contact.address.postalCode}</span>, e-pasts ${mail}, tālrunis ${tel}.`,
  },
  {
    lead: 'Kādus datus apstrādāju.',
    html: 'Vārdu, tālruņa numuru, e-pasta adresi, ziņas saturu un fotogrāfijas, ko nosūtāt kontaktformā, pa e-pastu, WhatsApp vai telefoniski.',
  },
  {
    lead: 'Kāpēc.',
    html: 'Lai atbildētu uz Jūsu pieprasījumu, sagatavotu cenas novērtējumu un izpildītu pasūtījumu.',
  },
  {
    lead: 'Tiesiskais pamats.',
    html: 'Jūsu piekrišana un pasākumi, ko veic pēc Jūsu pieprasījuma pirms līguma noslēgšanas un tā izpildei (Vispārīgās datu aizsardzības regulas 6.&nbsp;panta 1.&nbsp;punkta a) un b) apakšpunkts).',
  },
  {
    lead: 'Cik ilgi.',
    html: 'Datus glabāju tikai tik ilgi, cik nepieciešams, lai atbildētu uz pieprasījumu un izpildītu pasūtījumu, un pēc tam tos dzēšu, ja vien likums neprasa tos glabāt ilgāk.',
  },
  {
    lead: 'Kam datus nododu.',
    html: 'Datus nepārdodu un nenododu trešajām personām mārketinga nolūkos. Tehniski tie var tikt apstrādāti mājaslapas mitināšanas un e-pasta pakalpojumu sniedzēju sistēmās tikai ziņas nogādāšanai.',
  },
  {
    lead: 'Sīkdatnes.',
    html: 'Mājaslapa izmanto tikai tās darbībai nepieciešamās sīkdatnes. Apmeklējumu statistikas sīkdatnes tiek izmantotas tikai tad, ja tām piekrītat. Karte lapā „Kontakti” tiek ielādēta no Google tikai pēc Jūsu klikšķa; tad Google var apstrādāt Jūsu IP adresi un saglabāt savas sīkdatnes.',
  },
  {
    lead: 'Jūsu tiesības.',
    html: `Jūs varat pieprasīt piekļuvi saviem datiem, to labošanu vai dzēšanu, kā arī atsaukt piekrišanu, rakstot uz ${mail}. Ja uzskatāt, ka Jūsu dati apstrādāti nepareizi, varat iesniegt sūdzību Datu valsts inspekcijā (<a href="https://www.dvi.gov.lv" rel="noopener">www.dvi.gov.lv</a>).`,
  },
];

const schema = [
  breadcrumbs([
    { name: 'Sākums', path: '/' },
    { name: 'Privātuma politika', path: '/privatuma-politika' },
  ]),
];
---

<BaseLayout title={title} description={description} path="/privatuma-politika" schema={schema}>
  <InnerHero crumb="Privātuma politika" title="Privātuma politika" />

  <div class="container policy">
    {
      parts.map((p) => (
        <section class="policy__row">
          <h2>{p.lead}</h2>
          <p set:html={typo(p.html)} />
        </section>
      ))
    }
    {
      site.privacyDate && (
        <p class="policy__date">
          <strong>Spēkā no:</strong> 2026.&nbsp;gada {site.privacyDate}.
        </p>
      )
    }
  </div>
</BaseLayout>

<style>
  /* Katrs punkts - rinda: virsraksts kreisajās kolonnās, teksts no 6. kolonnas */
  .policy {
    padding-bottom: var(--section);
  }

  .policy__row {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-5) 0;
    border-top: 1px solid var(--hairline);
  }

  .policy__row h2 {
    font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem);
    font-weight: 480;
    line-height: 1.3;
  }

  .policy__row p {
    max-width: 64ch;
  }

  .policy__row a {
    font-weight: 650;
  }

  .policy__date {
    padding-top: var(--s-5);
    border-top: 1px solid var(--hairline);
    color: var(--ink-soft);
  }

  .policy__date strong {
    color: var(--chocolate);
  }

  @media (min-width: 64rem) {
    .policy__row {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--s-6);
      padding: var(--s-6) 0;
    }

    .policy__row h2 {
      grid-column: 1 / span 4;
    }

    .policy__row p {
      grid-column: 6 / -1;
    }
  }
</style>
