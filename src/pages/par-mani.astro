---
/**
 * /par-mani - arkveida portrets un Zaigas stāsts (lapas zīmīgais brīdis).
 * Bildes ar īsto Zaigu - tikai šeit, kur teksts runā par viņu.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerHero from '../components/page/InnerHero.astro';
import AsideImage from '../components/page/AsideImage.astro';
import Section from '../components/page/Section.astro';
import BenefitsBlock from '../components/page/BenefitsBlock.astro';
import ListBlock from '../components/page/ListBlock.astro';
import InnerCta from '../components/page/InnerCta.astro';

import { parMani } from '../data/pages/par-mani';
import { breadcrumbs } from '../lib/schema';
import { typo } from '../lib/typo';

const schema = [
  breadcrumbs([
    { name: 'Sākums', path: '/' },
    { name: parMani.name, path: parMani.path },
  ]),
];
---

<BaseLayout title={parMani.seo.title} description={parMani.seo.description} path={parMani.path} schema={schema}>
  <InnerHero crumb={parMani.name} title={parMani.h1} accent="Jūsu lietas" swoop={5.6} portrait class="about-hero">
    <AsideImage
      slot="media"
      image="zaigaPortrets"
      shape="arch"
      sizes="(min-width: 75rem) 380px, (min-width: 64rem) 30vw, (min-width: 43.75rem) 24rem, 84vw"
    />
    <ul role="list" class="facts">
      {parMani.facts.map((f) => <li>{typo(f)}</li>)}
    </ul>
  </InnerHero>

  <Section
    id="stasts"
    title={parMani.story.title}
    tones={{ from: 'cream', tone: 'linen', to: 'linen' }}
    aside={{ image: 'zaigaRokasAdisana', shape: 'print' }}
    class="story"
  >
    <div class="story__text">
      {parMani.story.paragraphs.map((p) => <p>{typo(p)}</p>)}
    </div>
  </Section>

  <BenefitsBlock
    id="ka-stradaju"
    block={{
      type: 'benefits',
      title: parMani.how.title,
      items: parMani.how.items,
      aside: { image: 'zaigaPieSujmasinas', shape: 'print' },
    }}
    tones={{ from: 'linen', tone: 'cream', to: 'cream' }}
    mirror
  />

  <section class="joy tone" aria-labelledby="prieks-title">
    <div class="container joy__inner">
      <h2 id="prieks-title">{parMani.joy.title}</h2>
      <p class="joy__text">{typo(parMani.joy.text)}</p>
    </div>
  </section>

  <ListBlock
    id="pieredze"
    block={{ type: 'list', title: parMani.experience.title, items: parMani.experience.items }}
    tones={{ from: 'linen', tone: 'cream', to: 'cream' }}
  />

  <InnerCta
    title={parMani.cta.title}
    text={parMani.cta.text}
    actions={parMani.cta.actions}
    tones={{ from: 'cream', tone: 'blush', to: 'blush' }}
  />
</BaseLayout>

<style>
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    margin-top: var(--s-2);
    font-size: var(--fs-small);
    font-weight: 650;
    color: var(--ink-soft);
  }

  .facts li {
    position: relative;
    padding-left: 22px;
  }

  /* Krustdūriens kā sarakstos */
  .facts li::before,
  .facts li::after {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.75em;
    width: 11px;
    height: 2px;
    border-radius: 1px;
    background: var(--thread);
    transform: rotate(45deg);
  }

  .facts li::after {
    transform: rotate(-45deg);
  }

  .story__text p {
    max-width: 56ch;
  }

  .story__text p + p {
    margin-top: 1em;
  }

  .story__text p:first-child {
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--chocolate);
  }

  /* „Kas sagādā prieku” - viens liels, kluss teikums */
  .joy {
    --from: var(--cream);
    --tone: var(--linen);
    --to: var(--linen);
    padding: var(--section) 0;
    text-align: center;
  }

  .joy__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .joy__inner h2 {
    max-width: 22ch;
    font-size: var(--fs-h3);
    font-weight: 450;
  }

  .joy__text {
    margin-top: var(--s-6);
    max-width: 30ch;
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 1.2rem + 1.9vw, 2.75rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--chocolate);
    text-wrap: balance;
  }

  @media (min-width: 64rem) {
    :global(.about-hero .ihero__head) {
      align-self: center;
    }
  }
</style>
